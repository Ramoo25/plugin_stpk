<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Листы и виды"
        Width="560" Height="720"
        MinWidth="420" MinHeight="480"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False">
  <Grid Margin="14">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <TextBlock Grid.Row="0" Text="Листы проекта" Margin="0,0,0,6"/>

    <ListBox Grid.Row="1" x:Name="lst_sheets"
             Margin="0,0,0,12"
             ScrollViewer.VerticalScrollBarVisibility="Auto"/>

    <WrapPanel Grid.Row="2" Margin="0,0,0,10">
      <CheckBox x:Name="chk_views"      Content="Виды"           IsChecked="True" Margin="0,0,14,4"/>
      <CheckBox x:Name="chk_schedules"  Content="Спецификации"   IsChecked="True" Margin="0,0,14,4"/>
      <CheckBox x:Name="chk_drafting"   Content="Чертёжные виды" IsChecked="True" Margin="0,0,14,4"/>
      <CheckBox x:Name="chk_legends"    Content="Легенды"        IsChecked="True" Margin="0,0,14,4"/>
    </WrapPanel>

    <TextBlock Grid.Row="3" Text="На выбранном листе" Margin="0,0,0,6"/>

    <ListBox Grid.Row="4" x:Name="lst_views"
             Margin="0,0,0,12"
             ScrollViewer.VerticalScrollBarVisibility="Auto"/>

    <StackPanel Grid.Row="5" Orientation="Horizontal"
                HorizontalAlignment="Right">
      <Button x:Name="btn_close" Content="Закрыть" Width="120"
              IsCancel="True"/>
    </StackPanel>
  </Grid>
</Window>
