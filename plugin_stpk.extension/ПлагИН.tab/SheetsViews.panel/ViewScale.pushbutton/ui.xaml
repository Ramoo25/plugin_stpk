<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Масштаб видов"
        Width="760" Height="640"
        MinWidth="600" MinHeight="480"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False">
  <Grid Margin="12">
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="*"/>
      <ColumnDefinition Width="Auto"/>
      <ColumnDefinition Width="0.9*"/>
    </Grid.ColumnDefinitions>

    <!-- ЛЕВАЯ КОЛОНКА: дерево «лист - виды» -->
    <Grid Grid.Column="0">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="*"/>
      </Grid.RowDefinitions>

      <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,6">
        <TextBlock Text="Листы проекта и виды на них" VerticalAlignment="Center"/>
        <Button x:Name="btn_clear" Content="Очистить выбор" Width="110" Height="22"
                Margin="12,0,0,0"
                ToolTip="Снять все галочки со всех видов"/>
      </StackPanel>

      <Grid Grid.Row="1" Margin="0,0,0,4">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <TextBlock Text="Содержит:" VerticalAlignment="Center" Margin="0,0,6,0"/>
        <TextBox Grid.Column="1" x:Name="tb_search" Height="24"
                 ToolTip="Фильтр: остаются листы/виды, где есть хотя бы одно из слов (несколько слов - через запятую)"/>
      </Grid>

      <Grid Grid.Row="2" Margin="0,0,0,4">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <TextBlock Text="НЕ содержит:" VerticalAlignment="Center" Margin="0,0,6,0"/>
        <TextBox Grid.Column="1" x:Name="tb_exclude" Height="24"
                 ToolTip="Исключение: скрываются листы/виды, где есть хотя бы одно из слов (несколько слов - через запятую)"/>
      </Grid>

      <StackPanel Grid.Row="3" Orientation="Horizontal">
        <CheckBox x:Name="chk_only" Content="Только выбранные"
                  ToolTip="Показать только виды с отметкой; оба поля фильтра игнорируются"/>
        <CheckBox x:Name="chk_pick" Content="Выбрать видимые"
                  ToolTip="Отметить все виды, видимые в списке после фильтрации;
повторить можно сняв и снова поставив галочку"/>
      </StackPanel>

      <Border Grid.Row="4" BorderBrush="#FFABADB3" BorderThickness="1">
        <TreeView x:Name="tv_views" BorderThickness="0"
                  VirtualizingPanel.IsVirtualizing="False"/>
      </Border>
    </Grid>

    <GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Center"
                  VerticalAlignment="Stretch" Background="Transparent"/>

    <!-- ПРАВАЯ КОЛОНКА: масштаб -->
    <Grid Grid.Column="2">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="*"/>
      </Grid.RowDefinitions>

      <GroupBox Grid.Row="0" Header="Масштаб отмеченных видов" Padding="10">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
          </Grid.RowDefinitions>

          <TextBlock Grid.Row="0" x:Name="lbl_selection"
                     Text="Отмечено видов: 0"/>

          <TextBlock Grid.Row="1"
                     Text="Масштаб (например, 100 или 1:100)"/>
          <ComboBox Grid.Row="2" x:Name="cb_scale" IsEditable="True"
                    Height="24" Margin="0,4,0,12"/>

          <Button Grid.Row="3" x:Name="btn_apply" Content="Применить"
                  Width="130" Height="30" HorizontalAlignment="Left"
                  IsEnabled="False"/>
        </Grid>
      </GroupBox>

      <StackPanel Grid.Row="1" VerticalAlignment="Bottom">
        <TextBlock x:Name="lbl_status" Text="" TextWrapping="Wrap" Margin="0,0,0,10"/>
        <Button x:Name="btn_close" Content="Закрыть" Width="110" Height="26"
                HorizontalAlignment="Right" IsCancel="True"/>
      </StackPanel>
    </Grid>
  </Grid>
</Window>
