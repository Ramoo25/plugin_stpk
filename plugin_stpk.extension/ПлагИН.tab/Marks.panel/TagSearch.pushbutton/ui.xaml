<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="МаркаПоиск"
        Width="640" Height="520"
        MinWidth="560" MinHeight="420"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False">
  <Grid Margin="12">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <TextBlock Grid.Row="0" x:Name="lbl_element" Text="" FontWeight="Bold"
               TextWrapping="Wrap" Margin="0,0,0,10"/>

    <TextBlock Grid.Row="1" Text="Марка по нескольким категориям:" FontWeight="Bold"
               Margin="0,0,0,2"/>
    <Grid Grid.Row="2" Margin="0,0,0,4">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto"/>
        <ColumnDefinition Width="*"/>
      </Grid.ColumnDefinitions>
      <TextBlock Text="Содержит:" VerticalAlignment="Center" Margin="0,0,6,0"/>
      <TextBox Grid.Column="1" x:Name="tb_search" Height="24"
               ToolTip="Фильтр списка марок по части имени (слова через пробел = «И»)"/>
    </Grid>
    <ComboBox Grid.Row="3" x:Name="cb_tag" Height="24" Margin="0,0,0,10"/>

    <Border Grid.Row="4" BorderBrush="#FFABADB3" BorderThickness="1">
      <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel x:Name="pnl_results" Margin="2"/>
      </ScrollViewer>
    </Border>

    <StackPanel Grid.Row="5" Margin="0,8,0,0">
      <TextBlock x:Name="lbl_status" Text="" TextWrapping="Wrap" Margin="0,0,0,8"/>
      <Button x:Name="btn_close" Content="Закрыть" Width="110" Height="26"
              HorizontalAlignment="Right" IsCancel="True"/>
    </StackPanel>
  </Grid>
</Window>
